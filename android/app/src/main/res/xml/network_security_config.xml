<?xml version="1.0" encoding="utf-8"?>
<!-- The server runs on the hospital LAN over plain HTTP, which Android blocks
     by default from Android 9 onward. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
