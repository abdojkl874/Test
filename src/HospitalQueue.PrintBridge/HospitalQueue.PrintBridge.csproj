<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Renders tickets via GDI+ and sends raw bytes to the Windows print
         spooler (winspool.drv P/Invoke), so this service only runs on the
         Windows kiosk PC — it is not meant to be hosted on the app server. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
