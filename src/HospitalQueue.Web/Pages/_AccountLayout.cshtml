@namespace HospitalQueue.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject HospitalQueue.Web.Services.BrandingService BrandingService
@{
    var brandCss = await BrandingService.GetCssVariablesAsync();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - نظام إدارة طابور المشفى</title>
    <base href="~/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(brandCss))
    {
        <style>@Html.Raw(brandCss)</style>
    }
</head>
<body>
    <div class="hq-login-shell">
        @RenderBody()
    </div>
</body>
</html>
