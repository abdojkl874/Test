@page "/display"
@layout BareLayout
@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IQueueService QueueService
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@inject HospitalQueue.Web.Services.QueueEventBus Bus
@implements IDisposable

<PageTitle>شاشة العرض</PageTitle>

<ScreenPasswordGate Title="شاشة العرض" PasswordHash="@displayPasswordHash">
    <div class="hq-display-shell">
        <div class="hq-display-header">
            <div class="hq-display-brand">
                <BrandLogo Height="46px" ShowFallback="false" />
                <span class="hq-display-dot"></span>
                @orgName
            </div>
            <div class="hq-display-clock">@clock.ToString("dddd، d MMMM yyyy — HH:mm:ss", arabicCulture)</div>
        </div>

        <div class="hq-display-grid">
            <div class="hq-display-now">
                @if (latest is null)
                {
                    <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Style="font-size:4rem; opacity:.5;" />
                    <div class="hq-display-now-label mt-3">بانتظار أول نداء</div>
                }
                else
                {
                    <div class="hq-display-now-label">آخر رقم تم نداؤه</div>
                    <div class="hq-display-now-number">@latest.Number</div>
                    <div class="hq-display-now-window">@latest.CounterName</div>
                    <div class="hq-display-now-service">@latest.ServiceName</div>
                    <div class="hq-display-now-status hq-status-@StatusClass(latest.Status)">@StatusLabel(latest.Status)</div>
                }
            </div>

            <div class="hq-display-recent">
                @if (!recent.Any())
                {
                    <div class="hq-empty" style="color:#9FC3DE;">لا توجد نداءات بعد</div>
                }
                else
                {
                    @for (var i = 0; i < recent.Count; i++)
                    {
                        var evt = recent[i];
                        // Only the newest row pulses — see .hq-recent-row.is-latest.
                        var latestClass = i == 0 ? "is-latest" : string.Empty;
                        <div class="hq-recent-row @(evt.IsRecall ? "is-recall" : "is-serving") @latestClass">
                            <div class="hq-recent-no">@evt.Number</div>
                            <div class="hq-recent-meta">
                                <div class="hq-recent-window">@evt.CounterName</div>
                                <div class="hq-recent-service">@evt.ServiceName</div>
                            </div>
                            <div class="hq-recent-status hq-status-@StatusClass(evt.Status)">@StatusLabel(evt.Status)</div>
                            <div style="color:#9FC3DE; font-variant-numeric: tabular-nums;">@evt.CalledAt.ToString("HH:mm")</div>
                        </div>
                    }
                }
            </div>
        </div>

        @if (tickerEnabled && !string.IsNullOrWhiteSpace(tickerText))
        {
            <div class="hq-ticker">
                <div class="hq-ticker-text" style="animation-duration:@(TickerDurationSeconds)s;">@tickerText</div>
            </div>
        }
    </div>
</ScreenPasswordGate>

@code {
    private TicketCalledEvent? latest;
    private readonly List<TicketCalledEvent> recent = new();
    private string orgName = "نظام إدارة طابور المشفى";
    private bool tickerEnabled;
    private string? tickerText;
    private string? displayPasswordHash;
    private DateTime clock = DateTime.Now;
    private readonly System.Globalization.CultureInfo arabicCulture = new("ar-SA");
    private System.Threading.Timer? clockTimer;

    private int TickerDurationSeconds => Math.Max(12, (tickerText?.Length ?? 0) / 4);

    protected override async Task OnInitializedAsync()
    {
        var settings = await Db.OrganizationSettings.FirstOrDefaultAsync();
        if (settings is not null)
        {
            orgName = settings.OrgNameAr;
            tickerEnabled = settings.TickerEnabled;
            tickerText = settings.TickerText;
            displayPasswordHash = settings.DisplayPasswordHash;
        }

        var recentEvents = await QueueService.GetRecentlyCalledAsync(15);
        recent.AddRange(recentEvents);
        latest = recent.FirstOrDefault();

        Bus.TicketCalled += OnTicketCalledAsync;
        Bus.TicketStatusChanged += OnTicketStatusChangedAsync;

        clockTimer = new System.Threading.Timer(_ =>
        {
            clock = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private Task OnTicketCalledAsync(TicketCalledEvent evt)
    {
        _ = InvokeAsync(async () =>
        {
            latest = evt;
            recent.RemoveAll(r => r.Number == evt.Number && r.ServiceId == evt.ServiceId);
            recent.Insert(0, evt);
            if (recent.Count > 15)
            {
                recent.RemoveRange(15, recent.Count - 15);
            }
            StateHasChanged();

            try
            {
                await JS.InvokeVoidAsync("hospitalQueueDisplay.ticketCalled", evt.Number, evt.ServiceName);
            }
            catch
            {
                // best-effort audio/voice announcement only
            }
        });

        return Task.CompletedTask;
    }

    private Task OnTicketStatusChangedAsync(TicketStatusChangedEvent evt)
    {
        _ = InvokeAsync(() =>
        {
            var index = recent.FindIndex(r => r.Number == evt.Number && r.ServiceId == evt.ServiceId);
            if (index < 0)
            {
                return;
            }

            recent[index] = recent[index] with { Status = evt.Status };
            if (latest?.Number == evt.Number && latest.ServiceId == evt.ServiceId)
            {
                latest = recent[index];
            }

            StateHasChanged();
        });

        return Task.CompletedTask;
    }

    private static string StatusLabel(TicketStatus status) => status switch
    {
        TicketStatus.Called => "تم النداء",
        TicketStatus.InService => "قيد الخدمة",
        TicketStatus.Done => "انتهت الخدمة",
        TicketStatus.Skipped => "لم يحضر",
        TicketStatus.Transferred => "تم التحويل",
        _ => status.ToString(),
    };

    private static string StatusClass(TicketStatus status) => status switch
    {
        TicketStatus.InService => "inservice",
        TicketStatus.Done => "done",
        TicketStatus.Skipped => "skipped",
        TicketStatus.Transferred => "transferred",
        _ => "called",
    };

    public void Dispose()
    {
        Bus.TicketCalled -= OnTicketCalledAsync;
        Bus.TicketStatusChanged -= OnTicketStatusChangedAsync;
        clockTimer?.Dispose();
    }
}
