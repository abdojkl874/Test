@page
@model HospitalQueue.Web.Pages.Account.PinLoginModel

<div class="hq-pin-card">
    <div style="color:var(--hq-muted); font-weight:600;">نظام إدارة طابور المشفى</div>
    <div class="hq-login-title">تسجيل دخول الجهاز</div>
    <div class="hq-login-subtitle">اختر الجهاز ثم أدخل الرمز السري</div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="hq-alert hq-alert-error">@Model.ErrorMessage</div>
    }

    @if (!Model.Accounts.Any())
    {
        <div class="hq-alert hq-alert-error">لا توجد أجهزة كشك أو عرض مفعّلة بعد. أنشئها من شاشة المستخدمين بحساب المدير.</div>
    }

    <form method="post" id="pinForm">
        <input type="hidden" name="Username" id="usernameInput" />
        <input type="hidden" name="Pin" id="pinInput" />

        <div class="hq-pin-accounts">
            @foreach (var acc in Model.Accounts)
            {
                <button type="button" class="hq-pin-account-btn" data-username="@acc.Username">@acc.FullName</button>
            }
        </div>

        <div class="hq-pin-dots" id="pinDots">
            <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>

        <div class="hq-pin-keypad">
            @for (var i = 1; i <= 9; i++)
            {
                <button type="button" class="hq-pin-key" data-digit="@i">@i</button>
            }
            <button type="button" class="hq-pin-key hq-pin-key-muted" id="pinClear">مسح</button>
            <button type="button" class="hq-pin-key" data-digit="0">0</button>
            <button type="button" class="hq-pin-key hq-pin-key-submit" id="pinSubmit">دخول</button>
        </div>
    </form>

    <div style="text-align:center; margin-top:1.2rem;">
        <a href="/Account/Login">تسجيل دخول الموظف / المدير</a>
    </div>
</div>

<script src="~/js/pin-login.js"></script>
