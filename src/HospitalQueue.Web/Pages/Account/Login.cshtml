@page
@model HospitalQueue.Web.Pages.Account.LoginModel

<div class="hq-login-card">
    <div style="color:var(--hq-muted); font-weight:600;">نظام إدارة طابور المشفى</div>
    <div class="hq-login-title">تسجيل الدخول</div>
    <div class="hq-login-subtitle">أدخل بيانات حسابك للمتابعة</div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="hq-alert hq-alert-error">@Model.ErrorMessage</div>
    }

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />

        <label class="hq-label" asp-for="Username">اسم المستخدم</label>
        <input asp-for="Username" class="hq-field" autofocus autocomplete="username" />

        <label class="hq-label" asp-for="Password">كلمة المرور</label>
        <input asp-for="Password" type="password" class="hq-field" autocomplete="current-password" />

        <button type="submit" class="hq-btn">دخول</button>
    </form>
</div>
