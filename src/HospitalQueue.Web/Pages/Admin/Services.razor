@page "/admin/services"
@attribute [Authorize(Roles = AppRoles.Admin)]
@layout AdminLayout
@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject ISnackbar Snackbar

<PageTitle>الخدمات والعيادات</PageTitle>

<MudText Typo="Typo.h4" Class="hq-page-title">الخدمات والعيادات</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <MudText Typo="Typo.subtitle1" Class="mb-3">إضافة خدمة/عيادة جديدة</MudText>
    <MudGrid AlignItems="Center">
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="newName" Label="الاسم" Variant="Variant.Outlined" Placeholder="مثال: الباطنية" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="newCode" Label="الرمز" Variant="Variant.Outlined" MaxLength="10" HelperText="يستخدم في رقم التذكرة، مثال A" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync" StartIcon="@Icons.Material.Filled.Add">إضافة</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <MudTable Items="services" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>الاسم</MudTh>
            <MudTh>الرمز</MudTh>
            <MudTh>الترتيب</MudTh>
            <MudTh>الحالة</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="الاسم"><MudTextField T="string" @bind-Value="context.NameAr" Variant="Variant.Text" /></MudTd>
            <MudTd DataLabel="الرمز"><MudTextField T="string" @bind-Value="context.Code" Variant="Variant.Text" MaxLength="10" Style="width:80px;" /></MudTd>
            <MudTd DataLabel="الترتيب"><MudNumericField T="int" @bind-Value="context.DisplayOrder" Variant="Variant.Text" Style="width:80px;" /></MudTd>
            <MudTd DataLabel="الحالة">
                <MudChip T="string" Class="@(context.IsActive ? "hq-chip-done" : "hq-chip-cancelled")">@(context.IsActive ? "مفعّلة" : "معطّلة")</MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => SaveAsync(context)" Class="me-2">حفظ</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="@(context.IsActive ? Color.Error : Color.Success)" OnClick="() => ToggleActiveAsync(context)">
                    @(context.IsActive ? "تعطيل" : "تفعيل")
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
    <MudText Typo="Typo.caption" Class="mt-3" Style="color:var(--hq-muted);">يتم تعطيل الخدمة بدلاً من حذفها للحفاظ على سجل التذاكر السابقة.</MudText>
</MudPaper>

@code {
    private List<Service> services = new();
    private string newName = string.Empty;
    private string newCode = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        services = await Db.Services.OrderBy(s => s.DisplayOrder).ToListAsync();
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newCode))
        {
            Snackbar.Add("الرجاء إدخال الاسم والرمز", Severity.Warning);
            return;
        }

        if (await Db.Services.AnyAsync(s => s.Code == newCode))
        {
            Snackbar.Add("هذا الرمز مستخدم مسبقاً", Severity.Warning);
            return;
        }

        Db.Services.Add(new Service
        {
            Id = Guid.NewGuid(),
            NameAr = newName.Trim(),
            Code = newCode.Trim().ToUpperInvariant(),
            DisplayOrder = services.Count,
            IsActive = true,
        });

        try
        {
            await Db.SaveChangesAsync();
            newName = string.Empty;
            newCode = string.Empty;
            await LoadAsync();
            Snackbar.Add("تمت الإضافة", Severity.Success);
        }
        catch (DbUpdateException)
        {
            Snackbar.Add("تعذر حفظ الخدمة، تأكد من عدم تكرار الرمز", Severity.Error);
        }
    }

    private async Task SaveAsync(Service service)
    {
        try
        {
            await Db.SaveChangesAsync();
            Snackbar.Add("تم الحفظ", Severity.Success);
        }
        catch (DbUpdateException)
        {
            Snackbar.Add("تعذر حفظ التعديلات", Severity.Error);
        }
    }

    private async Task ToggleActiveAsync(Service service)
    {
        service.IsActive = !service.IsActive;
        await Db.SaveChangesAsync();
    }
}
