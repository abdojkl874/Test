@page "/admin/services"
@attribute [Authorize(Roles = AppRoles.Admin)]
@layout AdminLayout
@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject ISnackbar Snackbar

<PageTitle>الخدمات والعيادات</PageTitle>

<MudText Typo="Typo.h4" Class="hq-page-title">الخدمات والعيادات</MudText>

@* Same shape as the users screen: a read-only listing, with creating and
   editing both behind one dialog. *@
<MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <MudTable Items="services" Dense="true" Hover="true">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle1">قائمة العيادات</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate"
                       StartIcon="@Icons.Material.Filled.Add">إضافة عيادة</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>الاسم</MudTh>
            <MudTh>الرمز</MudTh>
            <MudTh>الترتيب</MudTh>
            <MudTh>الحالة</MudTh>
            <MudTh Style="width:1%;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="الاسم">@context.NameAr</MudTd>
            <MudTd DataLabel="الرمز">@context.Code</MudTd>
            <MudTd DataLabel="الترتيب">@context.DisplayOrder</MudTd>
            <MudTd DataLabel="الحالة">
                <MudChip T="string" Size="Size.Small" Class="@(context.IsActive ? "hq-chip-done" : "hq-chip-cancelled")">
                    @(context.IsActive ? "مفعّلة" : "معطّلة")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Primary"
                               OnClick="() => OpenEdit(context)" title="إعدادات العيادة" />
            </MudTd>
        </RowTemplate>
    </MudTable>
    <MudText Typo="Typo.caption" Class="mt-3" Style="color:var(--hq-muted);">يتم تعطيل العيادة بدلاً من حذفها للحفاظ على سجل التذاكر السابقة.</MudText>
</MudPaper>

<MudDialog @bind-Visible="dialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(isNew ? Icons.Material.Filled.Add : Icons.Material.Filled.LocalHospital)" Class="me-2" />
            @(isNew ? "إضافة عيادة جديدة" : $"إعدادات العيادة — {editing?.NameAr}")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="editName" Label="الاسم" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="مثال: الباطنية" Class="mb-3" />

        <MudTextField @bind-Value="editCode" Label="الرمز" Variant="Variant.Outlined" Margin="Margin.Dense"
                      MaxLength="10" HelperText="يستخدم في رقم التذكرة، مثال A ‏→‏ A-014" Class="mb-3" />

        <MudNumericField T="int" @bind-Value="editDisplayOrder" Label="الترتيب في شاشة الكشك"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Class="mb-3" />

        @if (!isNew)
        {
            <MudDivider Class="mb-3" />
            <MudSwitch @bind-Value="editIsActive" Color="Color.Success"
                       Label="@(editIsActive ? "العيادة مفعّلة" : "العيادة معطّلة")" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">إلغاء</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                   StartIcon="@(isNew ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)">
            @(isNew ? "إضافة" : "حفظ")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Service> services = new();

    private bool dialogVisible;
    private bool isNew;
    private Service? editing;
    private string editName = string.Empty;
    private string editCode = string.Empty;
    private int editDisplayOrder;
    private bool editIsActive = true;

    private readonly DialogOptions dialogOptions = new()
    {
        MaxWidth = MaxWidth.ExtraSmall,
        FullWidth = true,
        CloseButton = true,
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        services = await Db.Services.OrderBy(s => s.DisplayOrder).ToListAsync();
    }

    private void OpenCreate()
    {
        isNew = true;
        editing = null;
        editName = string.Empty;
        editCode = string.Empty;
        editDisplayOrder = services.Count;
        editIsActive = true;
        dialogVisible = true;
    }

    private void OpenEdit(Service service)
    {
        isNew = false;
        editing = service;
        editName = service.NameAr;
        editCode = service.Code;
        editDisplayOrder = service.DisplayOrder;
        editIsActive = service.IsActive;
        dialogVisible = true;
    }

    private void CloseDialog()
    {
        dialogVisible = false;
        editing = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(editName) || string.IsNullOrWhiteSpace(editCode))
        {
            Snackbar.Add("الرجاء إدخال الاسم والرمز", Severity.Warning);
            return;
        }

        var name = editName.Trim();
        var code = editCode.Trim().ToUpperInvariant();

        // The code drives ticket numbers, so it has to stay unique — excluding
        // the row being edited from the check.
        var editingId = editing?.Id;
        if (await Db.Services.AnyAsync(s => s.Code == code && s.Id != editingId))
        {
            Snackbar.Add("هذا الرمز مستخدم مسبقاً", Severity.Warning);
            return;
        }

        if (isNew)
        {
            Db.Services.Add(new Service
            {
                Id = Guid.NewGuid(),
                NameAr = name,
                Code = code,
                DisplayOrder = editDisplayOrder,
                IsActive = true,
            });
        }
        else if (editing is not null)
        {
            editing.NameAr = name;
            editing.Code = code;
            editing.DisplayOrder = editDisplayOrder;
            editing.IsActive = editIsActive;
        }

        try
        {
            await Db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            Snackbar.Add("تعذر حفظ العيادة، تأكد من عدم تكرار الرمز", Severity.Error);
            return;
        }

        Snackbar.Add(isNew ? "تمت الإضافة" : "تم الحفظ", Severity.Success);
        CloseDialog();
        await LoadAsync();
    }
}
