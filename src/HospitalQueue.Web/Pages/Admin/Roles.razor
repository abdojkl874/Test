@page "/admin/roles"
@attribute [Authorize(Roles = AppRoles.Admin)]
@layout AdminLayout
@using System.Security.Claims
@using HospitalQueue.Domain.Entities
@using Microsoft.AspNetCore.Identity
@inject RoleManager<ApplicationRole> RoleManager
@inject ISnackbar Snackbar

<PageTitle>الأدوار والصلاحيات</PageTitle>

<MudText Typo="Typo.h4" Class="hq-page-title">الأدوار والصلاحيات</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <MudText Typo="Typo.subtitle1" Class="mb-3">إضافة دور جديد</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="newRoleName" Label="اسم الدور" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddRoleAsync" StartIcon="@Icons.Material.Filled.Add">إضافة</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-2" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <div class="hq-perm-matrix-scroll">
        <table class="hq-perm-matrix">
            <thead>
                <tr>
                    <th class="hq-perm-col-label">الصلاحية</th>
                    @foreach (var row in roleRows)
                    {
                        <th @key="row.Role.Id">
                            <div class="hq-perm-role-head">
                                <span>@row.Role.Name</span>
                                @if (!AppRoles.All.Contains(row.Role.Name))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="() => DeleteRoleAsync(row)" title="حذف الدور" />
                                }
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var permission in AppPermissions.All)
                {
                    <tr>
                        <td class="hq-perm-col-label">@PermissionLabel(permission)</td>
                        @foreach (var row in roleRows)
                        {
                            <td @key="row.Role.Id" class="hq-perm-cell">
                                <MudCheckBox T="bool" Value="row.Permissions.Contains(permission)"
                                             ValueChanged="@(v => TogglePermissionAsync(row, permission, v))" Color="Color.Primary" Dense="true" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</MudPaper>

@code {
    private class RoleRow
    {
        public ApplicationRole Role { get; set; } = null!;
        public HashSet<string> Permissions { get; set; } = new();
    }

    private List<RoleRow> roleRows = new();
    private string newRoleName = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        roleRows.Clear();
        foreach (var role in RoleManager.Roles.OrderBy(r => r.Name).ToList())
        {
            var claims = await RoleManager.GetClaimsAsync(role);
            roleRows.Add(new RoleRow
            {
                Role = role,
                Permissions = claims.Where(c => c.Type == AppPermissions.ClaimType).Select(c => c.Value).ToHashSet(),
            });
        }
    }

    private async Task AddRoleAsync()
    {
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            Snackbar.Add("الرجاء إدخال اسم الدور", Severity.Warning);
            return;
        }

        if (await RoleManager.RoleExistsAsync(newRoleName))
        {
            Snackbar.Add("يوجد دور بنفس الاسم", Severity.Warning);
            return;
        }

        await RoleManager.CreateAsync(new ApplicationRole(newRoleName.Trim()));
        newRoleName = string.Empty;
        await LoadAsync();
        Snackbar.Add("تمت إضافة الدور", Severity.Success);
    }

    private async Task DeleteRoleAsync(RoleRow row)
    {
        await RoleManager.DeleteAsync(row.Role);
        await LoadAsync();
    }

    private async Task TogglePermissionAsync(RoleRow row, string permission, bool grant)
    {
        if (grant)
        {
            await RoleManager.AddClaimAsync(row.Role, new Claim(AppPermissions.ClaimType, permission));
            row.Permissions.Add(permission);
        }
        else
        {
            var claims = await RoleManager.GetClaimsAsync(row.Role);
            var existing = claims.FirstOrDefault(c => c.Type == AppPermissions.ClaimType && c.Value == permission);
            if (existing is not null)
            {
                await RoleManager.RemoveClaimAsync(row.Role, existing);
            }
            row.Permissions.Remove(permission);
        }
    }

    private static string PermissionLabel(string permission) => permission switch
    {
        AppPermissions.UsersManage => "إدارة المستخدمين",
        AppPermissions.RolesManage => "إدارة الأدوار والصلاحيات",
        AppPermissions.ServicesManage => "إدارة الخدمات والعيادات",
        AppPermissions.CountersManage => "إدارة الشبابيك",
        AppPermissions.TicketsCall => "نداء المرضى",
        AppPermissions.TicketsCreate => "إصدار التذاكر (الكشك)",
        AppPermissions.ReportsView => "عرض التقارير",
        AppPermissions.DisplayView => "عرض شاشة النداء العامة",
        _ => permission,
    };
}
