@page "/admin/counters"
@attribute [Authorize(Roles = AppRoles.Admin)]
@layout AdminLayout
@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject ISnackbar Snackbar

<PageTitle>الشبابيك</PageTitle>

<MudText Typo="Typo.h4" Class="hq-page-title">الشبابيك</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <MudText Typo="Typo.subtitle1" Class="mb-3">إضافة شباك جديد</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="newName" Label="الاسم" Variant="Variant.Outlined" Placeholder="مثال: شباك 4" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync" StartIcon="@Icons.Material.Filled.Add">إضافة</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@foreach (var counter in counters)
{
    <MudPaper Class="pa-4 mb-3" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);" @key="counter.Id">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="counter.Name" Label="اسم الشباك" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => SaveAsync(counter)" Class="me-2">حفظ</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="@(counter.IsActive ? Color.Error : Color.Success)" OnClick="() => ToggleActiveAsync(counter)">
                    @(counter.IsActive ? "تعطيل" : "تفعيل")
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudSelect T="Guid" Label="الخدمات التي يخدمها هذا الشباك" MultiSelection="true"
                   SelectedValues="@SelectedServiceIds(counter)"
                   SelectedValuesChanged="@(v => SetCounterServicesAsync(counter, v))"
                   MultiSelectionTextFunc="@(selected => ServiceNamesText(selected))"
                   Variant="Variant.Outlined" Class="mt-3" AnchorOrigin="Origin.BottomCenter">
            @foreach (var service in allServices)
            {
                <MudSelectItem T="Guid" Value="@service.Id">@service.NameAr</MudSelectItem>
            }
        </MudSelect>
    </MudPaper>
}

@code {
    private List<Counter> counters = new();
    private List<Service> allServices = new();
    private string newName = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        counters = await Db.Counters
            .Include(c => c.CounterServices)
            .OrderBy(c => c.Name)
            .ToListAsync();
        allServices = await Db.Services.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToListAsync();
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            Snackbar.Add("الرجاء إدخال اسم الشباك", Severity.Warning);
            return;
        }

        if (await Db.Counters.AnyAsync(c => c.Name == newName))
        {
            Snackbar.Add("يوجد شباك بنفس الاسم", Severity.Warning);
            return;
        }

        Db.Counters.Add(new Counter { Id = Guid.NewGuid(), Name = newName.Trim(), IsActive = true });

        try
        {
            await Db.SaveChangesAsync();
            newName = string.Empty;
            await LoadAsync();
            Snackbar.Add("تمت الإضافة", Severity.Success);
        }
        catch (DbUpdateException)
        {
            Snackbar.Add("تعذر إضافة الشباك", Severity.Error);
        }
    }

    private async Task SaveAsync(Counter counter)
    {
        try
        {
            await Db.SaveChangesAsync();
            Snackbar.Add("تم الحفظ", Severity.Success);
        }
        catch (DbUpdateException)
        {
            Snackbar.Add("تعذر حفظ التعديلات", Severity.Error);
        }
    }

    private async Task ToggleActiveAsync(Counter counter)
    {
        counter.IsActive = !counter.IsActive;
        await Db.SaveChangesAsync();
    }

    private static IEnumerable<Guid> SelectedServiceIds(Counter counter) =>
        counter.CounterServices.Select(cs => cs.ServiceId).ToHashSet();

    private string ServiceNamesText(List<string> selectedValues)
    {
        // MudSelect hands the multi-selection text function the raw string form
        // of each selected value, so map them back to Guids to read the names.
        var ids = selectedValues
            .Select(v => Guid.TryParse(v, out var id) ? id : Guid.Empty)
            .Where(id => id != Guid.Empty)
            .ToHashSet();

        var names = allServices.Where(s => ids.Contains(s.Id)).Select(s => s.NameAr).ToList();
        return names.Count == 0 ? "لم يتم اختيار أي خدمة" : string.Join("، ", names);
    }

    private async Task SetCounterServicesAsync(Counter counter, IEnumerable<Guid> selected)
    {
        var target = selected.ToHashSet();

        foreach (var removed in counter.CounterServices.Where(cs => !target.Contains(cs.ServiceId)).ToList())
        {
            counter.CounterServices.Remove(removed);
            Db.Remove(removed);
        }

        foreach (var serviceId in target.Where(id => counter.CounterServices.All(cs => cs.ServiceId != id)))
        {
            counter.CounterServices.Add(new CounterService { CounterId = counter.Id, ServiceId = serviceId });
        }

        await Db.SaveChangesAsync();
    }
}
