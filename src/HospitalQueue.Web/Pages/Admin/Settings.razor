@page "/admin/settings"
@attribute [Authorize(Roles = AppRoles.Admin)]
@layout AdminLayout
@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HospitalQueue.Web.Services.BrandingService Branding

<PageTitle>الإعدادات العامة</PageTitle>

<MudText Typo="Typo.h4" Class="hq-page-title">الإعدادات العامة</MudText>

@if (settings is not null)
{
    <MudPaper Class="pa-5 mb-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg); max-width:620px;">
        <MudTextField @bind-Value="settings.OrgNameAr" Label="اسم الجهة (يظهر في التذاكر وشاشة العرض)" Variant="Variant.Outlined" Class="mb-4" />

        <MudSwitch @bind-Value="settings.TickerEnabled" Color="Color.Primary" Label="تفعيل الشريط الإخباري في شاشة العرض" Class="mb-3" />

        <MudTextField @bind-Value="settings.TickerText" Label="نص الشريط الإخباري" Variant="Variant.Outlined" Lines="2" Class="mb-4" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">حفظ</MudButton>
    </MudPaper>

    <MudPaper Class="pa-5 mb-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg); max-width:620px;">
        <MudText Typo="Typo.subtitle1" Class="mb-1">الهوية البصرية</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            الشعار يظهر في شاشة الدخول ولوحة التحكم والكشك وشاشة العرض. الألوان تُطبَّق على واجهة النظام بالكامل — اتركها فارغة للعودة للألوان الافتراضية.
        </MudText>

        <div class="hq-brand-upload mb-4">
            <div class="hq-brand-preview">
                @if (!string.IsNullOrEmpty(settings.LogoDataUrl))
                {
                    <img src="@settings.LogoDataUrl" alt="الشعار" />
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">لا يوجد شعار</MudText>
                }
            </div>
            <div>
                <InputFile OnChange="OnLogoSelectedAsync" accept="image/*" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">PNG أو SVG بخلفية شفافة، الحد الأقصى 2 ميغابايت</MudText>
                @if (!string.IsNullOrEmpty(settings.LogoDataUrl))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="mt-1"
                               StartIcon="@Icons.Material.Filled.Delete" OnClick="RemoveLogo">حذف الشعار</MudButton>
                }
            </div>
        </div>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="settings.BrandPrimaryColor" Label="اللون الأساسي (مثال: ‎#123B5E)"
                              Variant="Variant.Outlined" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Circle"
                              AdornmentColor="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="settings.BrandAccentColor" Label="لون التمييز (مثال: ‎#E0793F)"
                              Variant="Variant.Outlined" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Circle"
                              AdornmentColor="Color.Secondary" />
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveBrandingAsync"
                           StartIcon="@Icons.Material.Filled.Save">حفظ الهوية البصرية</MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                    بعد الحفظ، حدّث الصفحة (F5) لرؤية الألوان الجديدة مطبَّقة.
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-5" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg); max-width:620px;">
        <MudText Typo="Typo.subtitle1" Class="mb-1">كلمات سر شاشات الكشك والعرض</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            شاشتا الكشك والعرض تُفتحان بكلمة سر عامة واحدة بدل تسجيل الدخول بحساب مستخدم. اترك الحقل فارغاً للإبقاء على الكلمة الحالية.
        </MudText>

        <MudTextField @bind-Value="newKioskPassword" Label="كلمة سر شاشة الكشك الجديدة" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-2" />
        <MudText Typo="Typo.caption" Color="@(hasKioskPassword ? Color.Success : Color.Warning)" Class="mb-4 d-block">
            @(hasKioskPassword ? "مضبوطة حالياً" : "غير مضبوطة — شاشة الكشك مقفلة حتى تُضبط")
        </MudText>

        <MudTextField @bind-Value="newDisplayPassword" Label="كلمة سر شاشة العرض الجديدة" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-2" />
        <MudText Typo="Typo.caption" Color="@(hasDisplayPassword ? Color.Success : Color.Warning)" Class="mb-4 d-block">
            @(hasDisplayPassword ? "مضبوطة حالياً" : "غير مضبوطة — شاشة العرض مقفلة حتى تُضبط")
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveScreenPasswordsAsync">حفظ كلمات السر</MudButton>
    </MudPaper>

    <MudPaper Class="pa-5 mt-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg); max-width:620px;">
        <MudText Typo="Typo.subtitle1" Class="mb-1">مفاتيح الأجهزة المخصّصة</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            الجهاز الذي يفتح الرابط ومعه مفتاحه يدخل الشاشة مباشرة بلا كلمة سر — مخصّص لشاشة جدارية أو جهاز كشك لا لوحة مفاتيح له.
            انسخ الرابط كاملاً إلى تطبيق الأندرويد أو إلى صفحة البدء في المتصفح.
            <b>توليد مفتاح جديد يُبطل المفتاح القديم فوراً على كل الأجهزة.</b>
        </MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-1">شاشة العرض</MudText>
        <MudTextField T="string" Value="@DeviceUrl(settings.DisplayDeviceKey, "display")" ReadOnly="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="@(() => CopyAsync(DeviceUrl(settings.DisplayDeviceKey, "display")))" />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="mb-4"
                   StartIcon="@Icons.Material.Filled.Autorenew"
                   OnClick="@(() => RegenerateKeyAsync(isKiosk: false))">توليد مفتاح جديد لشاشة العرض</MudButton>

        <MudText Typo="Typo.subtitle2" Class="mb-1">شاشة الكشك</MudText>
        <MudTextField T="string" Value="@DeviceUrl(settings.KioskDeviceKey, "kiosk")" ReadOnly="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="@(() => CopyAsync(DeviceUrl(settings.KioskDeviceKey, "kiosk")))" />
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Autorenew"
                   OnClick="@(() => RegenerateKeyAsync(isKiosk: true))">توليد مفتاح جديد لشاشة الكشك</MudButton>
    </MudPaper>
}

@code {
    private static readonly PasswordHasher<object> Hasher = new();

    private OrganizationSettings? settings;
    private string newKioskPassword = string.Empty;
    private string newDisplayPassword = string.Empty;
    private bool hasKioskPassword;
    private bool hasDisplayPassword;

    protected override async Task OnInitializedAsync()
    {
        settings = await Db.OrganizationSettings.FirstOrDefaultAsync();
        hasKioskPassword = !string.IsNullOrEmpty(settings?.KioskPasswordHash);
        hasDisplayPassword = !string.IsNullOrEmpty(settings?.DisplayPasswordHash);

        // Mint the keys on first visit so there is always a link ready to copy.
        if (settings is not null &&
            (string.IsNullOrEmpty(settings.KioskDeviceKey) || string.IsNullOrEmpty(settings.DisplayDeviceKey)))
        {
            settings.KioskDeviceKey ??= DeviceKey.Generate();
            settings.DisplayDeviceKey ??= DeviceKey.Generate();
            await Db.SaveChangesAsync();
        }
    }

    /// <summary>The full address a dedicated device should open, key included.</summary>
    private string DeviceUrl(string? key, string screen)
    {
        var origin = new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);
        return string.IsNullOrEmpty(key) ? "—" : $"{origin}/{screen}?key={key}";
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add("تم نسخ الرابط", Severity.Success);
        }
        catch
        {
            // Clipboard access needs a secure context; over plain HTTP the admin
            // can still select the field and copy by hand.
            Snackbar.Add("تعذّر النسخ تلقائياً — حدّد النص وانسخه يدوياً", Severity.Info);
        }
    }

    private async Task RegenerateKeyAsync(bool isKiosk)
    {
        if (settings is null)
        {
            return;
        }

        if (isKiosk)
        {
            settings.KioskDeviceKey = DeviceKey.Generate();
        }
        else
        {
            settings.DisplayDeviceKey = DeviceKey.Generate();
        }

        await Db.SaveChangesAsync();
        Snackbar.Add("تم توليد مفتاح جديد — حدّث الرابط على الأجهزة", Severity.Warning);
    }

    private async Task SaveAsync()
    {
        await Db.SaveChangesAsync();
        Branding.Invalidate();
        Snackbar.Add("تم حفظ الإعدادات", Severity.Success);
    }

    private async Task OnLogoSelectedAsync(InputFileChangeEventArgs e)
    {
        if (settings is null || e.File is null)
        {
            return;
        }

        const long maxSize = 2 * 1024 * 1024;
        if (e.File.Size > maxSize)
        {
            Snackbar.Add("حجم الصورة كبير جداً (الحد الأقصى 2 ميغابايت)", Severity.Warning);
            return;
        }

        using var stream = e.File.OpenReadStream(maxSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        settings.LogoDataUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private void RemoveLogo()
    {
        if (settings is not null)
        {
            settings.LogoDataUrl = null;
        }
    }

    private async Task SaveBrandingAsync()
    {
        if (settings is null)
        {
            return;
        }

        settings.BrandPrimaryColor = NormalizeHex(settings.BrandPrimaryColor);
        settings.BrandAccentColor = NormalizeHex(settings.BrandAccentColor);

        await Db.SaveChangesAsync();
        Branding.Invalidate();
        Snackbar.Add("تم حفظ الهوية البصرية", Severity.Success);
    }

    /// <summary>Accepts "123B5E" as well as "#123B5E"; anything else is dropped rather than stored unusable.</summary>
    private static string? NormalizeHex(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var trimmed = value.Trim();
        if (!trimmed.StartsWith('#'))
        {
            trimmed = "#" + trimmed;
        }

        return System.Text.RegularExpressions.Regex.IsMatch(trimmed, "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$")
            ? trimmed.ToUpperInvariant()
            : null;
    }

    private async Task SaveScreenPasswordsAsync()
    {
        if (settings is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(newKioskPassword))
        {
            settings.KioskPasswordHash = Hasher.HashPassword(new object(), newKioskPassword);
            newKioskPassword = string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(newDisplayPassword))
        {
            settings.DisplayPasswordHash = Hasher.HashPassword(new object(), newDisplayPassword);
            newDisplayPassword = string.Empty;
        }

        await Db.SaveChangesAsync();
        hasKioskPassword = !string.IsNullOrEmpty(settings.KioskPasswordHash);
        hasDisplayPassword = !string.IsNullOrEmpty(settings.DisplayPasswordHash);
        Snackbar.Add("تم حفظ كلمات السر", Severity.Success);
    }
}
