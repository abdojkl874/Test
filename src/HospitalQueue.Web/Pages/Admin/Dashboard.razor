@page "/admin"
@attribute [Authorize(Roles = AppRoles.Admin)]
@layout AdminLayout
@inject IReportService ReportService

<PageTitle>لوحة التحكم</PageTitle>

<MudText Typo="Typo.h4" Class="hq-page-title">لوحة التحكم</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="من تاريخ" @bind-Date="fromDate" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="إلى تاريخ" @bind-Date="toDate" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync" StartIcon="@Icons.Material.Filled.Refresh">تحديث</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (summary is not null)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Class="hq-stat-tile" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Class="hq-stat-icon" />
                <div class="hq-stat-value">@summary.WaitingNow</div>
                <div class="hq-stat-label">بالانتظار الآن</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="hq-stat-tile hq-accent" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Class="hq-stat-icon" />
                <div class="hq-stat-value">@summary.InServiceNow</div>
                <div class="hq-stat-label">قيد الخدمة الآن</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="hq-stat-tile" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Class="hq-stat-icon" />
                <div class="hq-stat-value">@summary.ServiceStats.Sum(s => s.TicketCount)</div>
                <div class="hq-stat-label">إجمالي التذاكر بالفترة</div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
                <MudText Typo="Typo.subtitle1" Class="mb-2">عدد التذاكر لكل خدمة/عيادة</MudText>
                <MudChart ChartType="ChartType.Bar" ChartSeries="@ticketCountSeries" XAxisLabels="@serviceLabels" Height="280px" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
                <MudText Typo="Typo.subtitle1" Class="mb-2">متوسط زمن الانتظار (دقيقة)</MudText>
                <MudChart ChartType="ChartType.Bar" ChartSeries="@waitTimeSeries" XAxisLabels="@serviceLabels" Height="280px" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
                <MudText Typo="Typo.subtitle1" Class="mb-2">متوسط زمن الخدمة (دقيقة)</MudText>
                <MudChart ChartType="ChartType.Bar" ChartSeries="@serviceTimeSeries" XAxisLabels="@serviceLabels" Height="280px" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
                <MudText Typo="Typo.subtitle1" Class="mb-2">عدد التذاكر لكل موظف</MudText>
                <MudChart ChartType="ChartType.Bar" ChartSeries="@employeeSeries" XAxisLabels="@employeeLabels" Height="280px" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
        <MudText Typo="Typo.subtitle1" Class="mb-2">تفاصيل الخدمات</MudText>
        <MudTable Items="summary.ServiceStats" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>الخدمة</MudTh>
                <MudTh>العدد</MudTh>
                <MudTh>مكتملة</MudTh>
                <MudTh>متخطاة</MudTh>
                <MudTh>متوسط الانتظار (د)</MudTh>
                <MudTh>متوسط الخدمة (د)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="الخدمة">@context.ServiceName</MudTd>
                <MudTd DataLabel="العدد">@context.TicketCount</MudTd>
                <MudTd DataLabel="مكتملة">@context.CompletedCount</MudTd>
                <MudTd DataLabel="متخطاة">@context.SkippedCount</MudTd>
                <MudTd DataLabel="متوسط الانتظار">@context.AverageWaitMinutes</MudTd>
                <MudTd DataLabel="متوسط الخدمة">@context.AverageServiceMinutes</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
        <MudText Typo="Typo.subtitle1" Class="mb-2">سجل التذاكر</MudText>
        <MudTable Items="ticketLog" Dense="true" Hover="true" Bordered="true" Striped="true">
            <HeaderContent>
                <MudTh>رقم الدور</MudTh>
                <MudTh>الخدمة</MudTh>
                <MudTh>التاريخ</MudTh>
                <MudTh>الحالة</MudTh>
                <MudTh>من قام بخدمته</MudTh>
                <MudTh>زمن الانتظار (د)</MudTh>
                <MudTh>زمن الخدمة (د)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="رقم الدور">@context.Number</MudTd>
                <MudTd DataLabel="الخدمة">@context.ServiceName</MudTd>
                <MudTd DataLabel="التاريخ">@context.Date.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="الحالة">
                    <MudChip T="string" Size="Size.Small" Class="@TicketStatusChipClass(context.Status)">@TicketStatusLabel(context.Status)</MudChip>
                </MudTd>
                <MudTd DataLabel="من قام بخدمته">@(context.ServedByName ?? "-")</MudTd>
                <MudTd DataLabel="زمن الانتظار">@(context.WaitMinutes?.ToString("0.0") ?? "-")</MudTd>
                <MudTd DataLabel="زمن الخدمة">@(context.ServiceMinutes?.ToString("0.0") ?? "-")</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="صفوف لكل صفحة" InfoFormat="{first_item}-{last_item} من {all_items}" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    private DateTime? fromDate = DateTime.Today;
    private DateTime? toDate = DateTime.Today;
    private DashboardSummaryDto? summary;
    private List<TicketLogRowDto> ticketLog = new();

    private string[] serviceLabels = Array.Empty<string>();
    private string[] employeeLabels = Array.Empty<string>();
    private List<ChartSeries> ticketCountSeries = new();
    private List<ChartSeries> waitTimeSeries = new();
    private List<ChartSeries> serviceTimeSeries = new();
    private List<ChartSeries> employeeSeries = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var from = DateOnly.FromDateTime(fromDate ?? DateTime.Today);
        var to = DateOnly.FromDateTime(toDate ?? DateTime.Today);
        summary = await ReportService.GetDashboardAsync(from, to);
        ticketLog = (await ReportService.GetTicketLogAsync(from, to)).ToList();

        serviceLabels = summary.ServiceStats.Select(s => s.ServiceName).ToArray();
        ticketCountSeries = new List<ChartSeries>
        {
            new() { Name = "عدد التذاكر", Data = summary.ServiceStats.Select(s => (double)s.TicketCount).ToArray() },
        };
        waitTimeSeries = new List<ChartSeries>
        {
            new() { Name = "دقائق الانتظار", Data = summary.ServiceStats.Select(s => s.AverageWaitMinutes).ToArray() },
        };
        serviceTimeSeries = new List<ChartSeries>
        {
            new() { Name = "دقائق الخدمة", Data = summary.ServiceStats.Select(s => s.AverageServiceMinutes).ToArray() },
        };

        employeeLabels = summary.EmployeeStats.Select(e => e.EmployeeName).ToArray();
        employeeSeries = new List<ChartSeries>
        {
            new() { Name = "عدد التذاكر", Data = summary.EmployeeStats.Select(e => (double)e.TicketsHandled).ToArray() },
        };
    }

    private static string TicketStatusLabel(TicketStatus status) => status switch
    {
        TicketStatus.Waiting => "بالانتظار",
        TicketStatus.Called => "تم النداء",
        TicketStatus.InService => "قيد الخدمة",
        TicketStatus.Done => "مكتملة",
        TicketStatus.Skipped => "لم يحضر",
        TicketStatus.Transferred => "تم التحويل",
        TicketStatus.Cancelled => "ملغاة",
        _ => status.ToString(),
    };

    private static string TicketStatusChipClass(TicketStatus status) => status switch
    {
        TicketStatus.Waiting => "hq-chip-waiting",
        TicketStatus.Called or TicketStatus.InService => "hq-chip-inservice",
        TicketStatus.Done => "hq-chip-done",
        TicketStatus.Skipped => "hq-chip-skipped",
        TicketStatus.Transferred => "hq-chip-transferred",
        _ => "hq-chip-cancelled",
    };
}
