@page "/admin/users"
@attribute [Authorize(Roles = AppRoles.Admin)]
@layout AdminLayout
@using HospitalQueue.Domain.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<ApplicationRole> RoleManager
@inject ISnackbar Snackbar

<PageTitle>المستخدمون</PageTitle>

<MudText Typo="Typo.h4" Class="hq-page-title">المستخدمون</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <MudText Typo="Typo.subtitle1" Class="mb-3">إضافة مستخدم جديد</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="newUsername" Label="اسم المستخدم" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="newFullName" Label="الاسم الكامل" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="newEmployeeCode" Label="رقم الموظف (اختياري)" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="newPassword" Label="كلمة المرور المبدئية" InputType="InputType.Password" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12">
            <MudText Typo="Typo.body2" Class="mb-2">الدور / نوع الشاشة</MudText>
            @foreach (var role in AppRoles.All)
            {
                <MudCheckBox T="bool" Value="@newRoles.Contains(role)" ValueChanged="@(v => ToggleNewRole(role, v))" Label="@RoleLabel(role)" Color="Color.Primary" Class="d-inline-flex me-4" />
            }
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" StartIcon="@Icons.Material.Filled.PersonAdd">إنشاء المستخدم</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <MudTable Items="userRows" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>اسم المستخدم</MudTh>
            <MudTh>الاسم الكامل</MudTh>
            <MudTh>الأدوار</MudTh>
            <MudTh>الحالة</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="اسم المستخدم">@context.User.UserName</MudTd>
            <MudTd DataLabel="الاسم الكامل">@context.User.FullName</MudTd>
            <MudTd DataLabel="الأدوار">
                @foreach (var role in AppRoles.All)
                {
                    <MudCheckBox T="bool" Value="@context.Roles.Contains(role)" ValueChanged="@(v => ToggleUserRoleAsync(context, role, v))" Label="@RoleLabel(role)" Dense="true" Class="d-inline-flex me-3" />
                }
            </MudTd>
            <MudTd DataLabel="الحالة">
                <MudChip T="string" Class="@(context.User.IsActive ? "hq-chip-done" : "hq-chip-cancelled")">@(context.User.IsActive ? "مفعّل" : "معطّل")</MudChip>
            </MudTd>
            <MudTd>
                <div class="d-flex align-center flex-wrap" style="gap:8px;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="@(context.User.IsActive ? Color.Error : Color.Success)" OnClick="() => ToggleActiveAsync(context)">
                        @(context.User.IsActive ? "تعطيل" : "تفعيل")
                    </MudButton>
                    <MudTextField T="string" @bind-Value="context.NewPassword" Placeholder="كلمة مرور جديدة" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:170px;" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => ResetPasswordAsync(context)">تصفير كلمة المرور</MudButton>
                </div>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private class UserRow
    {
        public ApplicationUser User { get; set; } = null!;
        public List<string> Roles { get; set; } = new();
        public string? NewPassword { get; set; }
    }

    private List<UserRow> userRows = new();
    private string newUsername = string.Empty;
    private string newFullName = string.Empty;
    private string newEmployeeCode = string.Empty;
    private string newPassword = string.Empty;
    private HashSet<string> newRoles = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        userRows.Clear();
        foreach (var user in UserManager.Users.OrderBy(u => u.UserName).ToList())
        {
            var roles = await UserManager.GetRolesAsync(user);
            userRows.Add(new UserRow { User = user, Roles = roles.ToList() });
        }
    }

    private void ToggleNewRole(string role, bool assign)
    {
        if (assign) newRoles.Add(role);
        else newRoles.Remove(role);
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(newUsername) || string.IsNullOrWhiteSpace(newFullName) || string.IsNullOrWhiteSpace(newPassword))
        {
            Snackbar.Add("الرجاء تعبئة اسم المستخدم والاسم الكامل وكلمة المرور", Severity.Warning);
            return;
        }

        var user = new ApplicationUser
        {
            UserName = newUsername.Trim(),
            FullName = newFullName.Trim(),
            EmployeeCode = string.IsNullOrWhiteSpace(newEmployeeCode) ? null : newEmployeeCode.Trim(),
            IsActive = true,
            EmailConfirmed = true,
        };

        var result = await UserManager.CreateAsync(user, newPassword);
        if (!result.Succeeded)
        {
            Snackbar.Add(string.Join("، ", result.Errors.Select(e => e.Description)), Severity.Error);
            return;
        }

        if (newRoles.Any())
        {
            await UserManager.AddToRolesAsync(user, newRoles);
        }

        Snackbar.Add("تم إنشاء المستخدم بنجاح", Severity.Success);
        newUsername = string.Empty;
        newFullName = string.Empty;
        newEmployeeCode = string.Empty;
        newPassword = string.Empty;
        newRoles.Clear();
        await LoadAsync();
    }

    private async Task ToggleUserRoleAsync(UserRow row, string role, bool assign)
    {
        if (assign)
        {
            await UserManager.AddToRoleAsync(row.User, role);
            row.Roles.Add(role);
        }
        else
        {
            await UserManager.RemoveFromRoleAsync(row.User, role);
            row.Roles.Remove(role);
        }
    }

    private async Task ToggleActiveAsync(UserRow row)
    {
        row.User.IsActive = !row.User.IsActive;
        await UserManager.UpdateAsync(row.User);
    }

    private async Task ResetPasswordAsync(UserRow row)
    {
        if (string.IsNullOrWhiteSpace(row.NewPassword))
        {
            Snackbar.Add("الرجاء إدخال كلمة مرور جديدة", Severity.Warning);
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(row.User);
        var result = await UserManager.ResetPasswordAsync(row.User, token, row.NewPassword);
        if (!result.Succeeded)
        {
            Snackbar.Add(string.Join("، ", result.Errors.Select(e => e.Description)), Severity.Error);
            return;
        }

        Snackbar.Add($"تم تحديث كلمة مرور {row.User.UserName}", Severity.Success);
        row.NewPassword = null;
    }

    private static string RoleLabel(string role) => role switch
    {
        AppRoles.Admin => "مدير",
        AppRoles.Employee => "موظف",
        AppRoles.Kiosk => "كشك",
        AppRoles.Display => "عرض",
        _ => role,
    };
}
