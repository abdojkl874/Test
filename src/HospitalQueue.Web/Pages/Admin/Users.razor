@page "/admin/users"
@attribute [Authorize(Roles = AppRoles.Admin)]
@layout AdminLayout
@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<ApplicationRole> RoleManager
@inject ApplicationDbContext Db
@inject ISnackbar Snackbar

<PageTitle>المستخدمون</PageTitle>

<div class="hq-page-head">
    <MudText Typo="Typo.h4" Class="hq-page-title">المستخدمون</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate"
               StartIcon="@Icons.Material.Filled.PersonAdd">إضافة مستخدم</MudButton>
</div>

@* The table stays read-only at a glance; creating and editing both happen in
   the same dialog so a row is one line instead of a strip of controls. *@
<MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
    <MudTable Items="userRows" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>اسم المستخدم</MudTh>
            <MudTh>الاسم الكامل</MudTh>
            <MudTh>الدور</MudTh>
            <MudTh>العيادات المخصّصة</MudTh>
            <MudTh>الحالة</MudTh>
            <MudTh Style="width:1%;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="اسم المستخدم">@context.User.UserName</MudTd>
            <MudTd DataLabel="الاسم الكامل">@context.User.FullName</MudTd>
            <MudTd DataLabel="الدور">
                @if (context.Roles.Any())
                {
                    <MudChip T="string" Size="Size.Small">@RoleLabel(context.Roles[0])</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">بدون دور</MudText>
                }
            </MudTd>
            <MudTd DataLabel="العيادات المخصّصة">
                <MudText Typo="Typo.body2">@AssignedClinicsText(context)</MudText>
            </MudTd>
            <MudTd DataLabel="الحالة">
                <MudChip T="string" Size="Size.Small" Class="@(context.User.IsActive ? "hq-chip-done" : "hq-chip-cancelled")">
                    @(context.User.IsActive ? "مفعّل" : "معطّل")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Primary"
                               OnClick="() => OpenSettings(context)" title="إعدادات الحساب" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

<MudDialog @bind-Visible="dialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(isNew ? Icons.Material.Filled.PersonAdd : Icons.Material.Filled.ManageAccounts)" Class="me-2" />
            @(isNew ? "إضافة مستخدم جديد" : $"إعدادات الحساب — {editing?.User.UserName}")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (isNew)
        {
            <MudTextField @bind-Value="editUsername" Label="اسم المستخدم" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        }

        <MudTextField @bind-Value="editFullName" Label="الاسم الكامل" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

        <MudSelect T="string" @bind-Value="editRole" Label="الدور / نوع الشاشة" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
            <MudSelectItem Value="@string.Empty">بدون دور</MudSelectItem>
            @foreach (var role in AppRoles.All)
            {
                <MudSelectItem Value="@role">@RoleLabel(role)</MudSelectItem>
            }
        </MudSelect>

        @* Only the two roles that actually open the call screen can be
           restricted to particular clinics; the kiosk and display screens
           have no clinic of their own. *@
        <MudSelect T="Guid" MultiSelection="true"
                   Label="العيادات المخصّصة"
                   SelectedValues="@editServiceIds"
                   SelectedValuesChanged="@(v => editServiceIds = v.ToHashSet())"
                   MultiSelectionTextFunc="@(selected => ServiceNamesText(selected))"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                   AnchorOrigin="Origin.BottomCenter"
                   Disabled="!ClinicsApplyToRole(editRole) || !allServices.Any()">
            @foreach (var service in allServices)
            {
                <MudSelectItem T="Guid" Value="@service.Id">@service.NameAr</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
            @if (!ClinicsApplyToRole(editRole))
            {
                <text>تخصيص العيادات متاح لحسابات الموظف والمدير فقط.</text>
            }
            else
            {
                <text>اترك الاختيار فارغاً للسماح بكل العيادات.</text>
            }
        </MudText>

        <MudDivider Class="mb-3" />

        <MudTextField @bind-Value="editNewPassword"
                      Label="@(isNew ? "كلمة المرور المبدئية" : "كلمة مرور جديدة (اتركها فارغة لعدم التغيير)")"
                      InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

        @if (!isNew)
        {
            <MudSwitch @bind-Value="editIsActive" Color="Color.Success"
                       Label="@(editIsActive ? "الحساب مفعّل" : "الحساب معطّل")" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">إلغاء</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                   StartIcon="@(isNew ? Icons.Material.Filled.PersonAdd : Icons.Material.Filled.Save)">
            @(isNew ? "إنشاء" : "حفظ")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private class UserRow
    {
        public ApplicationUser User { get; set; } = null!;
        public List<string> Roles { get; set; } = new();

        /// <summary>Clinics this account may work; empty means unrestricted.</summary>
        public HashSet<Guid> ServiceIds { get; set; } = new();
    }

    private List<UserRow> userRows = new();
    private List<Service> allServices = new();

    private bool dialogVisible;
    private bool isNew;
    private UserRow? editing;
    private string editUsername = string.Empty;
    private string editFullName = string.Empty;
    private string editRole = string.Empty;
    private HashSet<Guid> editServiceIds = new();
    private string editNewPassword = string.Empty;
    private bool editIsActive = true;

    private readonly DialogOptions dialogOptions = new()
    {
        MaxWidth = MaxWidth.ExtraSmall,
        FullWidth = true,
        CloseButton = true,
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        allServices = await Db.Services.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToListAsync();
        var assignments = await Db.EmployeeServices.AsNoTracking().ToListAsync();

        userRows.Clear();
        foreach (var user in UserManager.Users.OrderBy(u => u.UserName).ToList())
        {
            var roles = await UserManager.GetRolesAsync(user);
            userRows.Add(new UserRow
            {
                User = user,
                Roles = roles.ToList(),
                ServiceIds = assignments.Where(a => a.EmployeeId == user.Id).Select(a => a.ServiceId).ToHashSet(),
            });
        }
    }

    /// <summary>Kiosk and display accounts never open the call screen, so a clinic assignment would mean nothing for them.</summary>
    private static bool ClinicsApplyToRole(string role) =>
        role is AppRoles.Employee or AppRoles.Admin;

    private string AssignedClinicsText(UserRow row)
    {
        if (!ClinicsApplyToRole(row.Roles.FirstOrDefault() ?? string.Empty))
        {
            return "—";
        }

        var names = allServices.Where(s => row.ServiceIds.Contains(s.Id)).Select(s => s.NameAr).ToList();
        return names.Count == 0 ? "كل العيادات" : string.Join("، ", names);
    }

    private string ServiceNamesText(List<string> selectedValues)
    {
        // MudSelect hands the multi-selection text function the raw string form
        // of each selected value, so map them back to Guids to read the names.
        var ids = selectedValues
            .Select(v => Guid.TryParse(v, out var id) ? id : Guid.Empty)
            .Where(id => id != Guid.Empty)
            .ToHashSet();

        var names = allServices.Where(s => ids.Contains(s.Id)).Select(s => s.NameAr).ToList();
        return names.Count == 0 ? "كل العيادات" : string.Join("، ", names);
    }

    private void OpenCreate()
    {
        isNew = true;
        editing = null;
        editUsername = string.Empty;
        editFullName = string.Empty;
        editRole = string.Empty;
        editServiceIds = new HashSet<Guid>();
        editNewPassword = string.Empty;
        editIsActive = true;
        dialogVisible = true;
    }

    private void OpenSettings(UserRow row)
    {
        isNew = false;
        editing = row;
        editUsername = row.User.UserName ?? string.Empty;
        editFullName = row.User.FullName;
        editRole = row.Roles.FirstOrDefault() ?? string.Empty;
        editServiceIds = new HashSet<Guid>(row.ServiceIds);
        editNewPassword = string.Empty;
        editIsActive = row.User.IsActive;
        dialogVisible = true;
    }

    private void CloseDialog()
    {
        dialogVisible = false;
        editing = null;
    }

    private Task SaveAsync() => isNew ? CreateAsync() : UpdateAsync();

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(editUsername) || string.IsNullOrWhiteSpace(editFullName) || string.IsNullOrWhiteSpace(editNewPassword))
        {
            Snackbar.Add("الرجاء تعبئة اسم المستخدم والاسم الكامل وكلمة المرور", Severity.Warning);
            return;
        }

        var user = new ApplicationUser
        {
            UserName = editUsername.Trim(),
            FullName = editFullName.Trim(),
            IsActive = true,
            EmailConfirmed = true,
        };

        var result = await UserManager.CreateAsync(user, editNewPassword);
        if (!result.Succeeded)
        {
            Snackbar.Add(string.Join("، ", result.Errors.Select(e => e.Description)), Severity.Error);
            return;
        }

        if (!string.IsNullOrEmpty(editRole))
        {
            await UserManager.AddToRoleAsync(user, editRole);
        }

        if (ClinicsApplyToRole(editRole) && editServiceIds.Count > 0)
        {
            foreach (var serviceId in editServiceIds)
            {
                Db.EmployeeServices.Add(new EmployeeService { EmployeeId = user.Id, ServiceId = serviceId });
            }

            await Db.SaveChangesAsync();
        }

        Snackbar.Add("تم إنشاء المستخدم بنجاح", Severity.Success);
        CloseDialog();
        await LoadAsync();
    }

    private async Task UpdateAsync()
    {
        if (editing is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(editFullName))
        {
            Snackbar.Add("الرجاء إدخال الاسم الكامل", Severity.Warning);
            return;
        }

        var row = editing;

        row.User.FullName = editFullName.Trim();
        row.User.IsActive = editIsActive;
        var update = await UserManager.UpdateAsync(row.User);
        if (!update.Succeeded)
        {
            Snackbar.Add(string.Join("، ", update.Errors.Select(e => e.Description)), Severity.Error);
            return;
        }

        if (!string.IsNullOrWhiteSpace(editNewPassword))
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(row.User);
            var reset = await UserManager.ResetPasswordAsync(row.User, token, editNewPassword);
            if (!reset.Succeeded)
            {
                Snackbar.Add(string.Join("، ", reset.Errors.Select(e => e.Description)), Severity.Error);
                return;
            }
        }

        await ApplyRoleAsync(row, editRole);

        // A role that can't work a clinic keeps no assignment at all, so the
        // rows don't linger and silently apply if the role changes back.
        await ApplyClinicsAsync(row, ClinicsApplyToRole(editRole) ? editServiceIds : new HashSet<Guid>());

        Snackbar.Add($"تم حفظ إعدادات {row.User.UserName}", Severity.Success);
        CloseDialog();
    }

    private async Task ApplyRoleAsync(UserRow row, string role)
    {
        // Every account may hold exactly one role, so switching roles clears
        // whatever was assigned before adding the new one.
        if (row.Roles.SequenceEqual(string.IsNullOrEmpty(role) ? Array.Empty<string>() : new[] { role }))
        {
            return;
        }

        if (row.Roles.Count > 0)
        {
            await UserManager.RemoveFromRolesAsync(row.User, row.Roles);
            row.Roles.Clear();
        }

        if (!string.IsNullOrEmpty(role))
        {
            await UserManager.AddToRoleAsync(row.User, role);
            row.Roles.Add(role);
        }
    }

    private async Task ApplyClinicsAsync(UserRow row, HashSet<Guid> target)
    {
        var existing = await Db.EmployeeServices.Where(es => es.EmployeeId == row.User.Id).ToListAsync();
        Db.EmployeeServices.RemoveRange(existing.Where(es => !target.Contains(es.ServiceId)));

        foreach (var serviceId in target.Where(id => existing.All(es => es.ServiceId != id)))
        {
            Db.EmployeeServices.Add(new EmployeeService { EmployeeId = row.User.Id, ServiceId = serviceId });
        }

        await Db.SaveChangesAsync();
        row.ServiceIds = target;
    }

    private static string RoleLabel(string role) => role switch
    {
        AppRoles.Admin => "مدير",
        AppRoles.Employee => "موظف",
        AppRoles.Kiosk => "كشك",
        AppRoles.Display => "عرض",
        _ => role,
    };
}
