@page "/employee/call"
@attribute [Authorize(Roles = AppRoles.Employee + "," + AppRoles.Admin)]
@using System.Security.Claims
@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IQueueService QueueService
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject HospitalQueue.Web.Services.QueueEventBus Bus
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>شاشة النداء</PageTitle>

<div class="hq-call-shell">
    @if (activeSession is null)
    {
        <MudPaper Class="pa-5" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
            <MudText Typo="Typo.h5" Class="mb-4">بدء جلسة عمل</MudText>

            <MudSelect T="string" Label="الشباك" @bind-Value="selectedCounterId" @bind-Value:after="OnSelectedCounterChangedAsync"
                       Variant="Variant.Outlined" Class="mb-4">
                @foreach (var counter in counters)
                {
                    <MudSelectItem Value="@counter.Id.ToString()">@counter.Name</MudSelectItem>
                }
            </MudSelect>

            @if (availableServices.Any())
            {
                <MudSelect T="string" Label="الخدمة / العيادة" @bind-Value="selectedServiceId" Variant="Variant.Outlined" Class="mb-4">
                    @foreach (var service in availableServices)
                    {
                        <MudSelectItem Value="@service.Id.ToString()">@service.NameAr</MudSelectItem>
                    }
                </MudSelect>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="StartSessionAsync">بدء العمل</MudButton>
        </MudPaper>
    }
    else
    {
        <div class="hq-window-card mb-4">
            <div class="hq-window-card-title">@activeSession.Counter.Name — @activeSession.Service.NameAr</div>
            <div class="hq-window-card-sub">@waitingCount مريض بانتظار هذه الخدمة</div>
        </div>

        @if (currentTicket is not null)
        {
            <MudPaper Class="pa-5 text-center" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius-lg);">
                <div class="hq-current-ticket">@currentTicket.Number</div>
                <MudChip T="string" Class="@StatusChipClass(currentTicket.Status)">@StatusLabel(currentTicket.Status)</MudChip>

                @if (serviceStartedAt is not null)
                {
                    <div class="hq-service-timer">
                        <MudIcon Icon="@Icons.Material.Filled.Timer" Class="hq-service-timer-icon" />
                        <span class="hq-service-timer-value">@ElapsedText</span>
                        <span class="hq-service-timer-label">زمن الخدمة</span>
                    </div>
                }

                <MudGrid Class="mt-4" Justify="Justify.Center">
                    <MudItem xs="6" sm="4">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="hq-action-btn"
                                   StartIcon="@Icons.Material.Filled.Campaign" OnClick="RecallAsync">إعادة نداء</MudButton>
                    </MudItem>
                    @if (currentTicket.Status == TicketStatus.Called)
                    {
                        <MudItem xs="6" sm="4">
                            <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true" Class="hq-action-btn"
                                       StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartServiceAsync">بدء الخدمة</MudButton>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Class="hq-action-btn"
                                       StartIcon="@Icons.Material.Filled.PersonOff" OnClick="SkipAsync">لم يحضر</MudButton>
                        </MudItem>
                    }
                    <MudItem xs="6" sm="4">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" Class="hq-action-btn"
                                   StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="ShowTransfer">تحويل</MudButton>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="hq-action-btn"
                                   StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="CompleteAsync">إنهاء الخدمة</MudButton>
                    </MudItem>
                </MudGrid>

                @if (showTransfer)
                {
                    <MudPaper Class="pa-4 mt-4 text-start" Elevation="0" Style="border:1px solid var(--hq-divider); border-radius: var(--hq-radius);">
                        <MudSelect T="string" Label="تحويل المريض إلى" @bind-Value="transferServiceId" Variant="Variant.Outlined" Class="mb-3">
                            @foreach (var service in allServices.Where(s => s.Id != currentTicket.ServiceId))
                            {
                                <MudSelectItem Value="@service.Id.ToString()">@service.NameAr</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="TransferAsync">تأكيد التحويل</MudButton>
                    </MudPaper>
                }

                <MudTextField @bind-Value="notes" Label="ملاحظات (اختياري عند الإنهاء)" Variant="Variant.Outlined" Lines="2" Class="mt-4" />
            </MudPaper>
        }
        else
        {
            <div class="text-center mt-6">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="hq-action-btn px-8"
                           StartIcon="@Icons.Material.Filled.NotificationsActive" OnClick="CallNextAsync" Disabled="isBusy">
                    استدعاء التالي
                </MudButton>
            </div>
        }

        <div class="text-center mt-6">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="EndSessionAsync">إنهاء الجلسة</MudButton>
        </div>
    }
</div>

@code {
    private Guid employeeId;
    private List<Counter> counters = new();
    private List<Service> allServices = new();
    private List<Service> availableServices = new();
    private string selectedCounterId = string.Empty;
    private string selectedServiceId = string.Empty;

    private CounterSession? activeSession;
    private TicketDto? currentTicket;
    private int waitingCount;
    private bool isBusy;
    private bool showTransfer;
    private string transferServiceId = string.Empty;
    private string? notes;

    private DateTime? serviceStartedAt;
    private System.Threading.Timer? serviceTimer;

    private string ElapsedText
    {
        get
        {
            if (serviceStartedAt is null)
            {
                return "00:00";
            }

            var elapsed = DateTime.UtcNow - serviceStartedAt.Value;
            if (elapsed < TimeSpan.Zero)
            {
                elapsed = TimeSpan.Zero;
            }

            return elapsed.TotalHours >= 1
                ? $"{(int)elapsed.TotalHours:D2}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
                : $"{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
        }
    }

    private void StartServiceTimer(DateTime startedAtUtc)
    {
        serviceStartedAt = startedAtUtc;
        serviceTimer?.Dispose();
        serviceTimer = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    private void StopServiceTimer()
    {
        serviceStartedAt = null;
        serviceTimer?.Dispose();
        serviceTimer = null;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        employeeId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        counters = await Db.Counters
            .Include(c => c.CounterServices).ThenInclude(cs => cs.Service)
            .Where(c => c.IsActive)
            .ToListAsync();
        allServices = await Db.Services.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToListAsync();

        Bus.QueueChanged += OnQueueChangedAsync;

        var existing = await QueueService.GetActiveSessionAsync(employeeId);
        if (existing is not null)
        {
            activeSession = existing;
            waitingCount = await QueueService.GetWaitingCountAsync(existing.ServiceId);
        }
    }

    private void OnSelectedCounterChangedAsync()
    {
        availableServices = counters.FirstOrDefault(c => c.Id.ToString() == selectedCounterId)
            ?.CounterServices.Select(cs => cs.Service).Where(s => s.IsActive).ToList() ?? new();
        selectedServiceId = availableServices.Count == 1 ? availableServices[0].Id.ToString() : string.Empty;
    }

    private async Task StartSessionAsync()
    {
        if (!Guid.TryParse(selectedCounterId, out var counterId) || !Guid.TryParse(selectedServiceId, out var serviceId))
        {
            Snackbar.Add("الرجاء اختيار الشباك والخدمة", Severity.Warning);
            return;
        }

        try
        {
            await QueueService.StartSessionAsync(employeeId, counterId, serviceId);
            activeSession = await QueueService.GetActiveSessionAsync(employeeId);
            waitingCount = await QueueService.GetWaitingCountAsync(serviceId);
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CallNextAsync()
    {
        if (activeSession is null || isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            var ticket = await QueueService.CallNextAsync(activeSession.Id);
            if (ticket is null)
            {
                Snackbar.Add("لا يوجد مرضى بانتظار هذه الخدمة حالياً", Severity.Info);
            }
            else
            {
                currentTicket = ticket;
                notes = null;
                showTransfer = false;
                StopServiceTimer();
            }
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RecallAsync()
    {
        if (currentTicket is null) return;
        try
        {
            currentTicket = await QueueService.RecallAsync(currentTicket.Id);
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task StartServiceAsync()
    {
        if (currentTicket is null) return;
        try
        {
            currentTicket = await QueueService.StartServiceAsync(currentTicket.Id);
            StartServiceTimer(DateTime.UtcNow);
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CompleteAsync()
    {
        if (currentTicket is null) return;
        try
        {
            await QueueService.CompleteAsync(currentTicket.Id, notes);
            currentTicket = null;
            notes = null;
            showTransfer = false;
            StopServiceTimer();
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SkipAsync()
    {
        if (currentTicket is null) return;
        try
        {
            await QueueService.SkipAsync(currentTicket.Id);
            currentTicket = null;
            showTransfer = false;
            StopServiceTimer();
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ShowTransfer() => showTransfer = !showTransfer;

    private async Task TransferAsync()
    {
        if (currentTicket is null || !Guid.TryParse(transferServiceId, out var targetServiceId))
        {
            Snackbar.Add("الرجاء اختيار الخدمة المطلوب التحويل إليها", Severity.Warning);
            return;
        }

        try
        {
            await QueueService.TransferAsync(currentTicket.Id, targetServiceId);
            currentTicket = null;
            showTransfer = false;
            transferServiceId = string.Empty;
            StopServiceTimer();
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task EndSessionAsync()
    {
        if (activeSession is null) return;
        await QueueService.EndSessionAsync(activeSession.Id);
        activeSession = null;
        currentTicket = null;
        selectedCounterId = string.Empty;
        selectedServiceId = string.Empty;
        StopServiceTimer();
    }

    private async Task OnQueueChangedAsync(Guid serviceId)
    {
        if (activeSession is not null && serviceId == activeSession.ServiceId)
        {
            waitingCount = await QueueService.GetWaitingCountAsync(serviceId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string StatusLabel(TicketStatus status) => status switch
    {
        TicketStatus.Called => "تم النداء",
        TicketStatus.InService => "قيد الخدمة",
        _ => status.ToString(),
    };

    private static string StatusChipClass(TicketStatus status) => status switch
    {
        TicketStatus.Called => "hq-chip-called",
        TicketStatus.InService => "hq-chip-inservice",
        _ => "hq-chip-waiting",
    };

    public void Dispose()
    {
        Bus.QueueChanged -= OnQueueChangedAsync;
        serviceTimer?.Dispose();
    }
}
