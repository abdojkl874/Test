@page "/employee/call"
@attribute [Authorize(Roles = AppRoles.Employee + "," + AppRoles.Admin)]
@using System.Security.Claims
@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IQueueService QueueService
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject HospitalQueue.Web.Services.QueueEventBus Bus
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>شاشة النداء</PageTitle>

<div class="hq-call-shell">
    @* The clinic picker lives on the main screen rather than behind a separate
       "start session" step: picking (or changing) it opens the matching session
       straight away. *@
    <div class="hq-session-bar">
        <div class="hq-session-bar-fields">
            <MudSelect T="string" Label="العيادة" Value="selectedServiceId" ValueChanged="OnServiceChangedAsync"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="hq-session-select">
                @foreach (var service in allServices)
                {
                    <MudSelectItem Value="@service.Id.ToString()">@service.NameAr</MudSelectItem>
                }
            </MudSelect>
        </div>

        @if (activeSession is null)
        {
            <div class="hq-session-hint">
                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" />
                <span>اختر العيادة لبدء العمل</span>
            </div>
        }
        else
        {
            <div class="hq-session-waiting">
                <span class="hq-session-waiting-count">@waitingCount</span>
                <span class="hq-session-waiting-label">بالانتظار</span>
            </div>
        }
    </div>

    @* Every action stays on screen in a fixed grid, enabled or disabled by
       the current ticket's state, so buttons never appear/disappear and
       shift the layout under the employee's finger mid-shift. *@
    <MudPaper Class="hq-call-panel" Elevation="0">
        <div class="hq-ticket-stage">
            @if (currentTicket is not null)
            {
                <div class="hq-current-ticket">@currentTicket.Number</div>
                <div class="hq-ticket-meta">
                    <MudChip T="string" Size="Size.Small" Class="@StatusChipClass(currentTicket.Status)">@StatusLabel(currentTicket.Status)</MudChip>
                    <span class="hq-service-timer @(serviceStartedAt is null ? "is-idle" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
                        <span class="hq-service-timer-value">@ElapsedText</span>
                    </span>
                </div>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber" Class="hq-ticket-empty-icon" />
                <div class="hq-ticket-empty-text">
                    @(activeSession is null ? "اختر العيادة للبدء" : "لا توجد تذكرة حالية")
                </div>
            }
        </div>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="hq-action-btn hq-action-primary"
                   StartIcon="@Icons.Material.Filled.NotificationsActive" OnClick="CallNextAsync"
                   Disabled="isBusy || activeSession is null || currentTicket is not null">
            استدعاء التالي
        </MudButton>

        <div class="hq-action-grid">
            @if (currentTicket?.Status == TicketStatus.InService)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="hq-action-btn"
                           StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="CompleteAsync">إنهاء الخدمة</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true" Class="hq-action-btn"
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartServiceAsync"
                           Disabled="currentTicket?.Status != TicketStatus.Called">بدء الخدمة</MudButton>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="hq-action-btn"
                       StartIcon="@Icons.Material.Filled.Campaign" OnClick="RecallAsync"
                       Disabled="currentTicket is null">إعادة نداء</MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Class="hq-action-btn"
                       StartIcon="@Icons.Material.Filled.PersonOff" OnClick="SkipAsync"
                       Disabled="currentTicket?.Status != TicketStatus.Called">لم يحضر</MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" Class="hq-action-btn"
                       StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="ShowTransfer"
                       Disabled="currentTicket is null">تحويل</MudButton>
        </div>

        @if (showTransfer && currentTicket is not null)
        {
            <div class="hq-transfer-panel">
                <MudSelect T="string" Label="تحويل المريض إلى" @bind-Value="transferServiceId" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                    @foreach (var service in allServices.Where(s => s.Id != currentTicket.ServiceId))
                    {
                        <MudSelectItem Value="@service.Id.ToString()">@service.NameAr</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="TransferAsync">تأكيد التحويل</MudButton>
            </div>
        }

        <MudTextField @bind-Value="notes" Label="ملاحظات (اختياري عند الإنهاء)" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Lines="2" Class="hq-notes-field" Disabled="currentTicket is null" />
    </MudPaper>
</div>

@code {
    private Guid employeeId;
    private List<Service> allServices = new();
    private string selectedServiceId = string.Empty;

    private ServiceSession? activeSession;
    private TicketDto? currentTicket;
    private int waitingCount;
    private bool isBusy;
    private bool showTransfer;
    private string transferServiceId = string.Empty;
    private string? notes;

    private DateTime? serviceStartedAt;
    private System.Threading.Timer? serviceTimer;

    private string ElapsedText
    {
        get
        {
            if (serviceStartedAt is null)
            {
                return "00:00";
            }

            var elapsed = DateTime.UtcNow - serviceStartedAt.Value;
            if (elapsed < TimeSpan.Zero)
            {
                elapsed = TimeSpan.Zero;
            }

            return elapsed.TotalHours >= 1
                ? $"{(int)elapsed.TotalHours:D2}:{elapsed.Minutes:D2}:{elapsed.Seconds:D2}"
                : $"{elapsed.Minutes:D2}:{elapsed.Seconds:D2}";
        }
    }

    private void StartServiceTimer(DateTime startedAtUtc)
    {
        serviceStartedAt = startedAtUtc;
        serviceTimer?.Dispose();
        serviceTimer = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    private void StopServiceTimer()
    {
        serviceStartedAt = null;
        serviceTimer?.Dispose();
        serviceTimer = null;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        employeeId = Guid.Parse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier)!);

        allServices = await Db.Services.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToListAsync();

        Bus.QueueChanged += OnQueueChangedAsync;

        var existing = await QueueService.GetActiveSessionAsync(employeeId);
        if (existing is not null)
        {
            activeSession = existing;
            selectedServiceId = existing.ServiceId.ToString();
            waitingCount = await QueueService.GetWaitingCountAsync(existing.ServiceId);
        }
    }

    private async Task OnServiceChangedAsync(string serviceId)
    {
        // Switching clinics ends the current session, which would strand a
        // patient who is already being called or served — so make the employee
        // finish (or skip/transfer) that ticket first.
        if (currentTicket is not null)
        {
            Snackbar.Add("الرجاء إنهاء التذكرة الحالية قبل تغيير العيادة", Severity.Warning);
            return;
        }

        selectedServiceId = serviceId;
        await SyncSessionAsync();
    }

    private async Task SyncSessionAsync()
    {
        if (!Guid.TryParse(selectedServiceId, out var serviceId))
        {
            return;
        }

        if (activeSession is not null && activeSession.ServiceId == serviceId)
        {
            return;
        }

        try
        {
            await QueueService.StartSessionAsync(employeeId, serviceId);
            activeSession = await QueueService.GetActiveSessionAsync(employeeId);
            waitingCount = await QueueService.GetWaitingCountAsync(serviceId);
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CallNextAsync()
    {
        if (activeSession is null || isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            var ticket = await QueueService.CallNextAsync(activeSession.Id);
            if (ticket is null)
            {
                Snackbar.Add("لا يوجد مرضى بانتظار هذه الخدمة حالياً", Severity.Info);
            }
            else
            {
                currentTicket = ticket;
                notes = null;
                showTransfer = false;
                StopServiceTimer();
            }
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RecallAsync()
    {
        if (currentTicket is null) return;
        try
        {
            currentTicket = await QueueService.RecallAsync(currentTicket.Id);
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task StartServiceAsync()
    {
        if (currentTicket is null) return;
        try
        {
            currentTicket = await QueueService.StartServiceAsync(currentTicket.Id);
            StartServiceTimer(DateTime.UtcNow);
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CompleteAsync()
    {
        if (currentTicket is null) return;
        try
        {
            await QueueService.CompleteAsync(currentTicket.Id, notes);
            currentTicket = null;
            notes = null;
            showTransfer = false;
            StopServiceTimer();
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SkipAsync()
    {
        if (currentTicket is null) return;
        try
        {
            await QueueService.SkipAsync(currentTicket.Id);
            currentTicket = null;
            showTransfer = false;
            StopServiceTimer();
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ShowTransfer() => showTransfer = !showTransfer;

    private async Task TransferAsync()
    {
        if (currentTicket is null || !Guid.TryParse(transferServiceId, out var targetServiceId))
        {
            Snackbar.Add("الرجاء اختيار الخدمة المطلوب التحويل إليها", Severity.Warning);
            return;
        }

        try
        {
            await QueueService.TransferAsync(currentTicket.Id, targetServiceId);
            currentTicket = null;
            showTransfer = false;
            transferServiceId = string.Empty;
            StopServiceTimer();
        }
        catch (QueueOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnQueueChangedAsync(Guid serviceId)
    {
        if (activeSession is not null && serviceId == activeSession.ServiceId)
        {
            waitingCount = await QueueService.GetWaitingCountAsync(serviceId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string StatusLabel(TicketStatus status) => status switch
    {
        TicketStatus.Called => "تم النداء",
        TicketStatus.InService => "قيد الخدمة",
        _ => status.ToString(),
    };

    private static string StatusChipClass(TicketStatus status) => status switch
    {
        TicketStatus.Called => "hq-chip-called",
        TicketStatus.InService => "hq-chip-inservice",
        _ => "hq-chip-waiting",
    };

    public void Dispose()
    {
        Bus.QueueChanged -= OnQueueChangedAsync;
        serviceTimer?.Dispose();
    }
}
