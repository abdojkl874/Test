@page "/kiosk"
@layout BareLayout
@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IQueueService QueueService
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>شاشة الكشك</PageTitle>

<ScreenPasswordGate Title="شاشة الكشك" PasswordHash="@kioskPasswordHash" DeviceKey="@kioskDeviceKey">
    <div class="hq-kiosk-shell">
        <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Inherit"
                       Style="position:absolute; top:1rem; inset-inline-start:1rem;"
                       OnClick="EnterFullscreenAsync" title="ملء الشاشة" />

        <div class="hq-kiosk-brand">
            <BrandLogo Height="64px" ShowFallback="false" />
        </div>

        @if (issuedTicket is null)
        {
            <div class="hq-kiosk-title">الرجاء اختيار الخدمة المطلوبة</div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Style="max-width:600px;">@errorMessage</MudAlert>
            }

            <div class="hq-kiosk-grid">
                @foreach (var service in services)
                {
                    <button class="hq-kiosk-tile" @onclick="() => IssueTicketAsync(service.Id)" disabled="@isBusy">
                        @service.NameAr
                    </button>
                }
            </div>
        }
        else
        {
            <div class="hq-kiosk-ticket-card">
                <MudText Typo="Typo.subtitle1" Color="Color.Default">رقم تذكرتك</MudText>
                <div class="hq-kiosk-ticket-number">@issuedTicket.Number</div>
                <MudText Typo="Typo.h6">@issuedTicket.ServiceName</MudText>
                <MudText Typo="Typo.body2" Class="mt-2" Color="Color.Secondary">يرجى الانتظار حتى يتم مناداة رقمك على شاشة العرض</MudText>

                @if (!printSucceeded)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3">تعذر إرسال التذكرة للطباعة، يرجى تدوين الرقم يدوياً</MudAlert>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="Reset">تذكرة جديدة</MudButton>
            </div>
        }
    </div>
</ScreenPasswordGate>

@code {
    private List<Service> services = new();
    private TicketDto? issuedTicket;
    private string? errorMessage;
    private bool isBusy;
    private bool printSucceeded = true;
    private string orgName = "نظام إدارة طابور المشفى";
    private string? activeTemplateElementsJson;
    private string? kioskPasswordHash;
    private string? kioskDeviceKey;
    private System.Timers.Timer? resetTimer;

    protected override async Task OnInitializedAsync()
    {
        services = await Db.Services.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToListAsync();
        var settings = await Db.OrganizationSettings.FirstOrDefaultAsync();
        if (settings is not null)
        {
            orgName = settings.OrgNameAr;
            kioskPasswordHash = settings.KioskPasswordHash;
            kioskDeviceKey = settings.KioskDeviceKey;
        }

        var activeTemplate = await Db.ReceiptTemplates.FirstOrDefaultAsync(t => t.IsActive);
        activeTemplateElementsJson = activeTemplate?.ElementsJson;
    }

    private Task EnterFullscreenAsync() => JS.InvokeVoidAsync("hospitalQueueKiosk.enter").AsTask();

    private async Task IssueTicketAsync(Guid serviceId)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            issuedTicket = await QueueService.CreateTicketAsync(serviceId);

            // Printing must never be able to freeze the kiosk: window.print()
            // blocks the browser tab until its dialog is dismissed (e.g. no
            // default printer configured), so it runs detached from this
            // method — the confirmation screen shows immediately regardless
            // of what happens with the print dialog.
            _ = PrintTicketSafelyAsync(issuedTicket);

            resetTimer?.Dispose();
            resetTimer = new System.Timers.Timer(10000) { AutoReset = false };
            resetTimer.Elapsed += async (_, _) => await InvokeAsync(Reset);
            resetTimer.Start();
        }
        catch (QueueOperationException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task PrintTicketSafelyAsync(TicketDto ticket)
    {
        var ok = false;
        try
        {
            ok = await JS.InvokeAsync<bool>(
                "hospitalQueuePrint.printTicket",
                ticket.Number,
                ticket.ServiceName,
                orgName,
                DateTime.Now.ToString("o"),
                activeTemplateElementsJson);
        }
        catch
        {
            // Printer/dialog problems are surfaced to the patient below, but
            // must never crash the circuit or block issuing further tickets.
        }

        await InvokeAsync(() =>
        {
            if (issuedTicket?.Id == ticket.Id)
            {
                printSucceeded = ok;
                StateHasChanged();
            }
        });
    }

    private void Reset()
    {
        issuedTicket = null;
        printSucceeded = true;
        resetTimer?.Dispose();
        resetTimer = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        resetTimer?.Dispose();
    }
}
