@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6">لوحة تحكم المدير</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mx-3">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Href="/Account/Logout" title="خروج" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always" Anchor="Anchor.Right">
        <div class="hq-drawer-brand">
            <div class="hq-brand-mark">ط</div>
            <span class="hq-brand-name">نظام الطابور</span>
        </div>
        <MudNavMenu>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" Class="hq-nav-link">لوحة التحكم</MudNavLink>
            <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.People" Class="hq-nav-link">المستخدمون</MudNavLink>
            <MudNavLink Href="/admin/roles" Icon="@Icons.Material.Filled.AdminPanelSettings" Class="hq-nav-link">الأدوار والصلاحيات</MudNavLink>
            <MudNavLink Href="/admin/services" Icon="@Icons.Material.Filled.LocalHospital" Class="hq-nav-link">الخدمات والعيادات</MudNavLink>
            <MudNavLink Href="/admin/counters" Icon="@Icons.Material.Filled.MeetingRoom" Class="hq-nav-link">الشبابيك</MudNavLink>
            <MudNavLink Href="/admin/receipt-designer" Icon="@Icons.Material.Filled.Receipt" Class="hq-nav-link">مصمّم الوصل</MudNavLink>
            <MudNavLink Href="/admin/settings" Icon="@Icons.Material.Filled.Settings" Class="hq-nav-link">الإعدادات العامة</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
}
