@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="2" Fixed="false">
        <MudText Typo="Typo.h6" Class="hq-brand-name">نظام إدارة طابور المشفى</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mx-3">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Href="/Account/Logout" title="خروج" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>
