@using HospitalQueue.Domain.Entities
@using HospitalQueue.Infrastructure.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

@if (unlocked)
{
    @ChildContent
}
else if (checkedSettings)
{
    <div class="hq-lock-shell">
        <MudPaper Class="pa-6 text-center hq-lock-card" Elevation="0">
            <MudText Typo="Typo.h5" Class="mb-1">@Title</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">أدخل كلمة السر للمتابعة</MudText>

            @if (!string.IsNullOrEmpty(error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
            }

            @if (!hasPassword)
            {
                <MudAlert Severity="Severity.Warning">لم يتم ضبط كلمة سر لهذه الشاشة بعد. راجع لوحة تحكم المدير ← الإعدادات العامة.</MudAlert>
            }
            else
            {
                <MudTextField T="string" @bind-Value="password" Label="كلمة السر" InputType="InputType.Password"
                              Variant="Variant.Outlined" Class="mb-4" Immediate="true"
                              @onkeyup="OnKeyUpAsync" Disabled="isBusy" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="TryUnlockAsync" Disabled="isBusy">دخول</MudButton>
            }
        </MudPaper>
    </div>
}

@code {
    private static readonly PasswordHasher<object> Hasher = new();

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public ScreenLock Screen { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool unlocked;
    private bool checkedSettings;
    private bool hasPassword;
    private string password = string.Empty;
    private string? error;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        var hash = await CurrentHashAsync();
        hasPassword = !string.IsNullOrEmpty(hash);
        checkedSettings = true;
    }

    private async Task<string?> CurrentHashAsync()
    {
        var settings = await Db.OrganizationSettings.AsNoTracking().FirstOrDefaultAsync();
        return Screen == ScreenLock.Kiosk ? settings?.KioskPasswordHash : settings?.DisplayPasswordHash;
    }

    private async Task OnKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await TryUnlockAsync();
        }
    }

    private async Task TryUnlockAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        error = null;
        try
        {
            var hash = await CurrentHashAsync();
            if (string.IsNullOrEmpty(hash) || string.IsNullOrEmpty(password) ||
                Hasher.VerifyHashedPassword(new object(), hash, password) == PasswordVerificationResult.Failed)
            {
                error = "كلمة السر غير صحيحة";
                password = string.Empty;
                return;
            }

            unlocked = true;
        }
        finally
        {
            isBusy = false;
        }
    }
}
